// SafetyGuard EHS 360 — modelo de dados
// Etapa 1 — Cadastro da Empresa
//   1.1 Empresa de Consultoria (matriz do sistema)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Conselho / orgao de registro do responsavel tecnico.
enum TipoRegistroRt {
  CREA
  CRM
  CREFITO
  COREN
  CRQ
  MTE
  OUTRO
}

enum RegimeTributario {
  SIMPLES_NACIONAL
  LUCRO_PRESUMIDO
  LUCRO_REAL
  MEI
}

enum AcaoAuditoria {
  CRIACAO
  ATUALIZACAO
  EXCLUSAO
}

enum PorteEmpresa {
  MEI
  ME
  EPP
  MEDIO
  GRANDE
}

enum SituacaoContrato {
  ATIVO
  SUSPENSO
  ENCERRADO
}

/// Situacao do terceiro na operacao do cliente.
/// BLOQUEADO impede a liberacao de acesso enquanto houver pendencia.
enum SituacaoTerceiro {
  ATIVO
  SUSPENSO
  BLOQUEADO
  ENCERRADO
}

enum TipoVinculoTerceiro {
  CONTRATO
  ORDEM_SERVICO
  OBRA
  SERVICO_EVENTUAL
}

/// Como o centro de negocio agrupa a operacao.
enum TipoCentroNegocio {
  REGIONAL
  UNIDADE
  TIPO_CONTRATO
  DIVISAO
}

enum SituacaoCentro {
  ATIVO
  INATIVO
}

/// Natureza da area de inspecao.
enum TipoArea {
  PRODUCAO
  MANUTENCAO
  ARMAZENAGEM
  LOGISTICA
  UTILIDADES
  LABORATORIO
  OBRA
  ADMINISTRATIVO
  AREA_EXTERNA
  OUTRO
}

/// Criticidade cadastral da area — orienta prioridade e frequencia de inspecao.
enum CriticidadeArea {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum SituacaoArea {
  ATIVA
  INATIVA
}

/// Tipo escolhido pelo inspetor logo apos ler o QR Code.
enum TipoObservacao {
  COMPORTAMENTO_SEGURO
  COMPORTAMENTO_INSEGURO
  CONDICAO_INSEGURA
  MELHORIA_IDENTIFICADA
  NAO_CONFORMIDADE
}

enum SituacaoObservacao {
  REGISTRADA
  EM_TRATATIVA
  CONCLUIDA
  CANCELADA
}

/// Classificacao da Piramide de Bird.
enum ClassificacaoBird {
  A_MAJOR
  B_SERIOUS
  C_MINOR
  D_MAJOR_NEAR_MISS
  E_NEAR_MISS
  F_FIRST_AID
}

/// Grau de risco da ocorrencia, usado pela matriz de comunicacao.
enum GrauRiscoOcorrencia {
  I
  II
  III
}

enum OrigemPlano {
  OBSERVACAO
  AUDITORIA
  INSPECAO
  MANUAL
}

enum CriticidadePlano {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum StatusPlano {
  ABERTO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

enum CanalNotificacao {
  EMAIL
  WHATSAPP
  /// Ligacao de voz — Risco I fora do horario comercial ou fallback sem entrega.
  VOZ
}

/// Prioridade de disparo, herdada da Matriz de Comunicacao.
enum PrioridadeNotificacao {
  CRITICA
  ALTA
  MEDIA
  BAIXA
}

/// SIMULADA = mensagem montada e registrada, sem provedor acionado.
enum StatusNotificacao {
  SIMULADA
  ENVIADA
  FALHOU
}

/// Perfis de acesso — Diretoria, Gerencia, Supervisao, Tecnicos e Clientes.
enum Perfil {
  ADMIN
  DIRETORIA
  GERENTE
  COORDENADOR
  SUPERVISOR
  TECNICO
  CLIENTE
}

/// Empresa de consultoria — matriz do sistema.
///
/// Primeiro cadastro da plataforma. Alimenta o cabecalho dos relatorios, a
/// assinatura dos e-mails, o cabecalho das mensagens de WhatsApp e o rodape
/// dos laudos e auditorias. Existe um unico registro, garantido pela coluna
/// `chaveMatriz`.
model EmpresaConsultoria {
  id String @id @default(uuid())

  /// Trava de unicidade: garante uma unica matriz por instalacao.
  chaveMatriz String @unique @default("MATRIZ")

  // --- Identificacao ------------------------------------------------------
  razaoSocial        String            @db.VarChar(150)
  nomeFantasia       String            @db.VarChar(120)
  /// Somente digitos/letras, sem mascara. Aceita CNPJ alfanumerico (2026+).
  cnpj               String            @unique @db.VarChar(14)
  inscricaoEstadual  String?           @db.VarChar(20)
  inscricaoMunicipal String?           @db.VarChar(20)
  /// Subclasse CNAE com 7 digitos, sem mascara.
  cnaePrincipal      String?           @db.VarChar(7)
  naturezaJuridica   String?           @db.VarChar(120)
  regimeTributario   RegimeTributario?
  dataFundacao       DateTime?         @db.Date

  // --- Contato institucional ---------------------------------------------
  email           String  @db.VarChar(150)
  emailFinanceiro String? @db.VarChar(150)
  /// Somente digitos, com DDD.
  telefone        String  @db.VarChar(11)
  whatsapp        String? @db.VarChar(11)
  site            String? @db.VarChar(150)

  // --- Endereco -----------------------------------------------------------
  cep         String  @db.VarChar(8)
  logradouro  String  @db.VarChar(150)
  numero      String  @db.VarChar(20)
  complemento String? @db.VarChar(80)
  bairro      String  @db.VarChar(80)
  cidade      String  @db.VarChar(80)
  uf          String  @db.Char(2)

  // --- Responsavel tecnico (assina laudos e auditorias) -------------------
  responsavelTecnicoNome         String         @db.VarChar(120)
  responsavelTecnicoCargo        String?        @db.VarChar(80)
  responsavelTecnicoTipoRegistro TipoRegistroRt
  responsavelTecnicoRegistro     String         @db.VarChar(40)
  responsavelTecnicoUfRegistro   String?        @db.Char(2)
  responsavelTecnicoEmail        String?        @db.VarChar(150)
  responsavelTecnicoTelefone     String?        @db.VarChar(11)

  // --- Identidade visual e textos institucionais --------------------------
  logoUrl           String? @db.VarChar(300)
  corPrimaria       String  @default("#059669") @db.VarChar(7)
  corSecundaria     String  @default("#0e1a2b") @db.VarChar(7)
  /// Assinatura aplicada ao rodape dos e-mails enviados pela plataforma.
  assinaturaEmail   String? @db.VarChar(500)
  /// Texto fixo do rodape de laudos, relatorios e auditorias.
  rodapeRelatorio   String? @db.VarChar(500)
  /// Cabecalho aplicado as notificacoes de WhatsApp.
  cabecalhoWhatsapp String? @db.VarChar(160)
  /// Texto padrao impresso em toda Ordem de Servico (orientacoes gerais, NR-1).
  textoPadraoOs             String? @db.Text
  /// Link da plataforma de treinamentos da consultoria (botao na tela de treinamentos).
  urlPlataformaTreinamentos String? @db.VarChar(300)

  // --- Configuracao -------------------------------------------------------
  timezone String  @default("America/Sao_Paulo") @db.VarChar(60)
  ativa    Boolean @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  clientes         Cliente[]
  centrosDeNegocio CentroNegocio[]

  @@map("empresa_consultoria")
}

/// Cliente / contratante — empresa atendida pela consultoria.
///
/// Etapa 2 do cadastro. E a chave de segmentacao de toda a plataforma:
/// ranking por cliente, filtro dos dashboards e escopo das inspecoes,
/// planos de acao e documentos emitidos.
model Cliente {
  id        String             @id @default(uuid())
  empresaId String
  empresa   EmpresaConsultoria @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  /// Centro de negocio (regional, unidade ou tipo de contrato) ao qual pertence.
  /// `Restrict`: um centro com clientes vinculados nao pode ser excluido.
  centroNegocioId String?
  centroNegocio   CentroNegocio? @relation(fields: [centroNegocioId], references: [id], onDelete: Restrict)

  // --- Identificacao ------------------------------------------------------
  razaoSocial        String        @db.VarChar(150)
  nomeFantasia       String        @db.VarChar(120)
  /// Somente digitos/letras, sem mascara. Aceita CNPJ alfanumerico (2026+).
  cnpj               String        @db.VarChar(14)
  inscricaoEstadual  String?       @db.VarChar(20)
  inscricaoMunicipal String?       @db.VarChar(20)
  cnaePrincipal      String?       @db.VarChar(7)
  porte              PorteEmpresa?
  segmento           String?       @db.VarChar(80)
  site               String?       @db.VarChar(150)

  // --- Contrato -----------------------------------------------------------
  numeroContrato       String           @db.VarChar(40)
  dataInicioContrato   DateTime         @db.Date
  dataFimContrato      DateTime?        @db.Date
  situacao             SituacaoContrato @default(ATIVO)
  escopoServicos       String?          @db.VarChar(500)
  valorMensal          Decimal?         @db.Decimal(12, 2)
  diaVencimento        Int?             @db.SmallInt
  /// Consultor da matriz responsavel pela conta (vira vinculo de usuario na etapa de acessos).
  consultorResponsavel String?          @db.VarChar(120)

  // --- Perfil SSMA (alimenta ranking e indicadores) -----------------------
  /// Grau de risco NR-4, Quadro I (1 a 4).
  grauRisco              Int
  quantidadeFuncionarios Int
  /// Meta do Indice Global SSMA (0–100) usada no ranking e nos alertas.
  metaIndiceGlobal       Decimal @default(85) @db.Decimal(5, 2)
  possuiCipa             Boolean @default(false)
  possuiSesmt            Boolean @default(false)

  /// QR Code unico do cliente: abre a lista de areas para a pessoa escolher onde esta.
  tokenQr String? @unique @db.VarChar(64)

  // --- Interlocutor no cliente --------------------------------------------
  contatoNome     String  @db.VarChar(120)
  contatoCargo    String? @db.VarChar(80)
  contatoEmail    String  @db.VarChar(150)
  contatoTelefone String  @db.VarChar(11)
  contatoWhatsapp String? @db.VarChar(11)

  // --- Endereco da sede ----------------------------------------------------
  cep         String  @db.VarChar(8)
  logradouro  String  @db.VarChar(150)
  numero      String  @db.VarChar(20)
  complemento String? @db.VarChar(80)
  bairro      String  @db.VarChar(80)
  cidade      String  @db.VarChar(80)
  uf          String  @db.Char(2)

  // --- Identidade e anotacoes ---------------------------------------------
  logoUrl         String? @db.VarChar(300)
  /// Imagem de planta baixa para o mapa de calor por coordenada.
  imagemPlantaUrl String? @db.VarChar(300)
  /// Cor da serie do cliente nos graficos comparativos.
  corDestaque     String  @default("#2563eb") @db.VarChar(7)
  observacoes     String? @db.VarChar(1000)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  terceiros             Terceiro[]
  areas                 Area[]
  observacoesDeCampo    Observacao[]
  planosDeAcao          PlanoAcao[]
  colaboradores         Colaborador[]
  documentos            DocumentoSsma[]
  auditorias            Auditoria[]
  registrosDds          RegistroDds[]
  ocorrenciasAmbientais OcorrenciaAmbiental[]
  indicadoresAmbientais IndicadorAmbiental[]
  acidentes             Acidente[]
  inventarioRiscos      InventarioRisco[]
  notificacoes          Notificacao[]
  usuarios              Usuario[]
  afastamentos          Afastamento[]
  parametrosFinanceiros ParametrosFinanceiros?
  ordensServico         OrdemServico[]
  aprs                  Apr[]
  modelosChecklist      ModeloChecklist[]
  execucoesChecklist    ExecucaoChecklist[]
  contatos              ContatoCliente[]
  lancamentos           LancamentoFinanceiro[]
  registrosPonto        RegistroPonto[]
  cipas                 Cipa[]
  avaliacoesErgonomicas AvaliacaoErgonomica[]
  produtosQuimicos      ProdutoQuimico[]
  brigadistas           Brigadista[]
  extintores            Extintor[]
  aspectosAmbientais    AspectoAmbiental[]

  @@unique([empresaId, cnpj])
  @@unique([empresaId, numeroContrato])
  @@index([empresaId, situacao])
  @@index([empresaId, nomeFantasia])
  @@index([centroNegocioId])
  @@map("cliente")
}

/// Centro de negocio / unidade — Etapa 4.
///
/// Agrupamento intermediario entre a matriz e os clientes, usado quando a
/// consultoria organiza a operacao por regional, por unidade ou por tipo de
/// contrato. E um dos filtros transversais dos dashboards.
model CentroNegocio {
  id        String             @id @default(uuid())
  empresaId String
  empresa   EmpresaConsultoria @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  // --- Identificacao ------------------------------------------------------
  nome      String            @db.VarChar(120)
  /// Codigo curto usado em relatorios, filtros e exportacoes.
  codigo    String            @db.VarChar(20)
  tipo      TipoCentroNegocio
  descricao String?           @db.VarChar(500)

  // --- Responsavel ---------------------------------------------------------
  responsavelNome     String  @db.VarChar(120)
  responsavelCargo    String? @db.VarChar(80)
  responsavelEmail    String  @db.VarChar(150)
  responsavelTelefone String? @db.VarChar(11)
  responsavelWhatsapp String? @db.VarChar(11)

  // --- Localizacao de referencia ------------------------------------------
  cidade String? @db.VarChar(80)
  uf     String? @db.Char(2)

  // --- Gestao --------------------------------------------------------------
  /// Meta do Indice Global SSMA do centro.
  metaIndiceGlobal Decimal        @default(85) @db.Decimal(5, 2)
  situacao         SituacaoCentro @default(ATIVO)
  corDestaque      String         @default("#0e1a2b") @db.VarChar(7)
  observacoes      String?        @db.VarChar(1000)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  clientes Cliente[]

  @@unique([empresaId, codigo])
  @@index([empresaId, situacao])
  @@index([empresaId, nome])
  @@map("centro_negocio")
}

/// Empresa contratada / terceiro — Etapa 3.
///
/// Empresa terceirizada que atua dentro da operacao de um cliente
/// (ex.: montagem eletromecanica, pintura industrial) e que tambem recebe
/// nota e ranking de desempenho SSMA.
///
/// O mesmo CNPJ pode aparecer em mais de um cliente: sao cadastros distintos,
/// porque a nota, a documentacao e a atuacao sao por operacao.
model Terceiro {
  id        String  @id @default(uuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  // --- Identificacao ------------------------------------------------------
  razaoSocial        String        @db.VarChar(150)
  nomeFantasia       String        @db.VarChar(120)
  /// Somente digitos/letras, sem mascara. Aceita CNPJ alfanumerico (2026+).
  cnpj               String        @db.VarChar(14)
  inscricaoEstadual  String?       @db.VarChar(20)
  cnaePrincipal      String?       @db.VarChar(7)
  porte              PorteEmpresa?
  /// O que o terceiro executa na operacao.
  atividadePrincipal String        @db.VarChar(120)

  // --- Atuacao na operacao do cliente -------------------------------------
  tipoVinculo            TipoVinculoTerceiro @default(CONTRATO)
  numeroContrato         String?             @db.VarChar(40)
  dataInicioAtuacao      DateTime            @db.Date
  dataFimAtuacao         DateTime?           @db.Date
  situacao               SituacaoTerceiro    @default(ATIVO)
  escopoServicos         String?             @db.VarChar(500)
  /// Areas/frentes do cliente onde o terceiro atua.
  areasAtuacao           String?             @db.VarChar(300)
  quantidadeFuncionarios Int

  // --- Perfil SSMA e desempenho -------------------------------------------
  /// Grau de risco NR-4, Quadro I (1 a 4).
  grauRisco           Int
  /// Nota de desempenho SSMA (0–100) que posiciona o terceiro no ranking.
  /// Lancada manualmente ate as inspecoes existirem; depois passa a ser calculada.
  notaSsma            Decimal?  @db.Decimal(5, 2)
  dataUltimaAvaliacao DateTime? @db.Date
  metaNotaSsma        Decimal   @default(85) @db.Decimal(5, 2)

  // --- Documentacao e conformidade ----------------------------------------
  possuiPgr             Boolean   @default(false)
  possuiPcmso           Boolean   @default(false)
  /// Vencimento da pasta de documentos do terceiro.
  documentacaoValidaAte DateTime? @db.Date

  // --- Preposto / responsavel ---------------------------------------------
  responsavelNome     String  @db.VarChar(120)
  responsavelCargo    String? @db.VarChar(80)
  responsavelEmail    String  @db.VarChar(150)
  responsavelTelefone String  @db.VarChar(11)
  responsavelWhatsapp String? @db.VarChar(11)

  // --- Endereco (bloco inteiro opcional) ----------------------------------
  cep         String? @db.VarChar(8)
  logradouro  String? @db.VarChar(150)
  numero      String? @db.VarChar(20)
  complemento String? @db.VarChar(80)
  bairro      String? @db.VarChar(80)
  cidade      String? @db.VarChar(80)
  uf          String? @db.Char(2)

  // --- Identidade e anotacoes ---------------------------------------------
  logoUrl     String? @db.VarChar(300)
  corDestaque String  @default("#7c3aed") @db.VarChar(7)
  observacoes String? @db.VarChar(1000)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  observacoesDeCampo Observacao[]
  planosDeAcao       PlanoAcao[]
  colaboradores      Colaborador[]
  documentos         DocumentoSsma[]
  aprs               Apr[]

  @@unique([clienteId, cnpj])
  @@index([clienteId, situacao])
  @@index([clienteId, nomeFantasia])
  @@index([notaSsma])
  @@map("terceiro")
}

/// Area de inspecao — Etapa 5.
///
/// Ponto de leitura da inspecao de campo: cada area tem um QR Code proprio
/// que abre o formulario de observacao ja identificado com cliente, area e
/// riscos esperados.
model Area {
  id        String  @id @default(uuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  /// Agrupamento livre dentro do cliente (planta, unidade, predio).
  setor String? @db.VarChar(80)

  // --- Identificacao ------------------------------------------------------
  nome      String   @db.VarChar(120)
  /// Codigo curto impresso na placa do QR Code. Unico por cliente.
  codigo    String   @db.VarChar(20)
  tipo      TipoArea
  descricao String?  @db.VarChar(500)

  // --- QR Code -------------------------------------------------------------
  /// Token gravado no QR. Gerado pelo servidor e estavel: reimprimir a placa
  /// nao invalida as leituras anteriores.
  tokenQr String @unique @db.VarChar(16)

  // --- Risco ---------------------------------------------------------------
  criticidade             CriticidadeArea
  /// Riscos presentes, separados por ponto e virgula.
  riscosPresentes         String?         @db.VarChar(300)
  exigeAutorizacaoEntrada Boolean         @default(false)
  exigePermissaoTrabalho  Boolean         @default(false)

  // --- Responsavel pela area -----------------------------------------------
  responsavelNome     String? @db.VarChar(120)
  responsavelCargo    String? @db.VarChar(80)
  responsavelEmail    String? @db.VarChar(150)
  responsavelTelefone String? @db.VarChar(11)

  // --- Localizacao fisica --------------------------------------------------
  latitude        Decimal? @db.Decimal(10, 7)
  longitude       Decimal? @db.Decimal(10, 7)
  pontoReferencia String?  @db.VarChar(150)

  // --- Inspecao ------------------------------------------------------------
  /// Periodicidade minima de inspecao, em dias.
  frequenciaInspecaoDias Int          @default(30)
  situacao               SituacaoArea @default(ATIVA)
  observacoes            String?      @db.VarChar(1000)

  // --- Mapa de calor por planta (coordenadas relativas 0-100) ---------------
  /// Posicao horizontal (%) na imagem de planta do cliente. Null = sem coordenada.
  coordPlantaX Float?
  /// Posicao vertical (%) na imagem de planta do cliente. Null = sem coordenada.
  coordPlantaY Float?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  observacoesDeCampo Observacao[]
  planosDeAcao       PlanoAcao[]
  colaboradores      Colaborador[]
  documentos         DocumentoSsma[]

  registrosDds          RegistroDds[]
  acidentes             Acidente[]
  inventarioRiscos      InventarioRisco[]
  ocorrenciasAmbientais OcorrenciaAmbiental[]
  aprs                  Apr[]
  execucoesChecklist    ExecucaoChecklist[]

  brigadistas           Brigadista[]
  extintores            Extintor[]
  aspectosAmbientais    AspectoAmbiental[]
  produtosQuimicos      ProdutoQuimico[]
  avaliacoesErgonomicas AvaliacaoErgonomica[]

  @@unique([clienteId, codigo])
  @@index([clienteId, situacao])
  @@index([clienteId, criticidade])
  @@map("area")
}

/// Catalogo de causas de desvio — base do Pareto.
///
/// As causas sao catalogadas, e nao texto livre, porque o Pareto so faz
/// sentido se "Nao utilizacao de EPI" for sempre a mesma coisa.
model CausaDesvio {
  id                   String         @id @default(uuid())
  codigo               String         @unique @db.VarChar(20)
  descricao            String         @db.VarChar(120)
  tipo                 TipoObservacao
  /// Setor que costuma resolver — alimenta o roteamento da comunicacao.
  destinatarioSugerido String?        @db.VarChar(60)
  ativa                Boolean        @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  observacoes Observacao[]

  @@index([tipo, ativa])
  @@map("causa_desvio")
}

/// Observacao de campo — Etapa 6.
///
/// Evento que alimenta todos os indicadores (ICS, ICI, Pareto, tendencia,
/// mapa de calor, Piramide de Bird) e dispara a matriz de comunicacao.
model Observacao {
  id String @id @default(uuid())

  areaId String
  area   Area   @relation(fields: [areaId], references: [id], onDelete: Restrict)

  /// Derivado da area pelo servidor — evita join em toda agregacao.
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  /// Terceiro envolvido, quando o desvio e de uma contratada.
  terceiroId String?
  terceiro   Terceiro? @relation(fields: [terceiroId], references: [id], onDelete: SetNull)

  causaId String?
  causa   CausaDesvio? @relation(fields: [causaId], references: [id], onDelete: Restrict)

  // --- Classificacao --------------------------------------------------------
  dataHora   DateTime       @default(now())
  tipo       TipoObservacao
  descricao  String         @db.VarChar(1000)
  observador String         @db.VarChar(120)

  // --- Avaliacao de risco ----------------------------------------------------
  severidade    Int?
  probabilidade Int?
  exposicao     Int?
  frequencia    Int?
  /// IIR = severidade x probabilidade x exposicao x frequencia. Calculado no servidor.
  iir           Int?
  /// Derivado do IIR; define prazo e destinatarios na matriz de comunicacao.
  grauRisco     GrauRiscoOcorrencia?

  classificacaoBird ClassificacaoBird?

  // --- Evidencias -------------------------------------------------------------
  fotoUrl       String?  @db.VarChar(300)
  assinaturaUrl String?  @db.VarChar(300)
  /// Carimbo da assinatura: hash SHA-256 do arquivo + quem + quando. Sem o
  /// carimbo a imagem e so uma foto; com ele, qualquer alteracao posterior
  /// no arquivo ou nos dados e detectavel.
  assinaturaHash String?   @db.VarChar(64)
  assinaturaEm   DateTime?
  assinaturaPor  String?   @db.VarChar(120)
  latitude      Decimal? @db.Decimal(10, 7)
  longitude     Decimal? @db.Decimal(10, 7)

  // --- Tratativa --------------------------------------------------------------
  acaoImediata String?            @db.VarChar(500)
  situacao     SituacaoObservacao @default(REGISTRADA)
  observacoes  String?            @db.VarChar(1000)
  /// Prazo calculado pela matriz de comunicacao no momento do registro.
  prazoLimite  DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  planosDeAcao         PlanoAcao[]
  consequencias        Consequencia[]
  acidentes            Acidente[]
  documentosVinculados DocumentoSsma[]
  notificacoes         Notificacao[]

  @@index([clienteId, dataHora])
  @@index([clienteId, tipo, dataHora])
  @@index([areaId, dataHora])
  @@index([terceiroId, dataHora])
  @@index([causaId])
  @@map("observacao")
}

/// Plano de acao — Etapa 7.
///
/// A tratativa da ocorrencia. Nasce automaticamente da observacao quando o tipo
/// exige, com prazo e criticidade vindos da matriz de comunicacao.
model PlanoAcao {
  id     String @id @default(uuid())
  /// Identificador legivel (PA-0001), usado em relatorios e mensagens.
  codigo String @unique @db.VarChar(20)

  origem OrigemPlano @default(MANUAL)

  observacaoId String?
  observacao   Observacao? @relation(fields: [observacaoId], references: [id], onDelete: SetNull)

  /// Derivado da observacao/area pelo servidor.
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  areaId String?
  area   Area?   @relation(fields: [areaId], references: [id], onDelete: SetNull)

  terceiroId String?
  terceiro   Terceiro? @relation(fields: [terceiroId], references: [id], onDelete: SetNull)

  // --- O que fazer ---------------------------------------------------------
  acao      String  @db.VarChar(300)
  descricao String? @db.VarChar(1000)

  // --- Quem e quando --------------------------------------------------------
  responsavelNome  String           @db.VarChar(120)
  responsavelCargo String?          @db.VarChar(80)
  responsavelEmail String?          @db.VarChar(150)
  criticidade      CriticidadePlano
  prazo            DateTime

  // --- Andamento -------------------------------------------------------------
  status              StatusPlano @default(ABERTO)
  dataConclusao       DateTime?
  evidenciaUrl        String?     @db.VarChar(300)
  /// Foto da situacao encontrada (o "antes"); a evidencia e o "depois".
  fotoInicialUrl      String?     @db.VarChar(300)
  comentarioConclusao String?     @db.VarChar(1000)
  observacoes         String?     @db.VarChar(1000)

  // --- Cobranca da chefia -----------------------------------------------------
  /// Quando o plano passou do prazo + carencia da criticidade (10/20/30 dias) e a
  /// chefia hierarquica do cliente foi avisada por e-mail. Nulo = ainda nao cobrado.
  cobrancaChefiaEm DateTime?

  // --- Escalonamento ---------------------------------------------------------
  /// Degrau ja acionado: 0 Supervisor, 1 Coordenador, 2 Gerente, 3 Corporativa.
  nivelEscalonamento      Int       @default(0)
  dataUltimoEscalonamento DateTime?
  /// Momento da primeira resposta (status saiu de ABERTO) — base do KPI de
  /// tempo medio de resposta definido na Matriz de Comunicacao.
  dataInicioTratativa     DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  notificacoes     Notificacao[]
  acidentes        Acidente[]
  inventarioRiscos InventarioRisco[]

  @@index([clienteId, status, prazo])
  @@index([clienteId, criticidade])
  @@index([status, prazo])
  @@map("plano_acao")
}

/// Registro de notificacao — o "Dashboard de Comunicacao" do plano diretor.
///
/// Guarda a mensagem exatamente como foi montada, com destinatarios e canal.
/// Enquanto nao ha provedor, o status e SIMULADA: da rastreabilidade e permite
/// auditar o que *seria* enviado.
model Notificacao {
  id String @id @default(uuid())

  planoAcaoId String?
  planoAcao   PlanoAcao? @relation(fields: [planoAcaoId], references: [id], onDelete: Cascade)

  observacaoId String?
  observacao   Observacao? @relation(fields: [observacaoId], references: [id], onDelete: Cascade)

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  canal              CanalNotificacao
  /// Papeis acionados, separados por virgula (SUPERVISOR,COORDENADOR).
  destinatarios      String                @db.VarChar(300)
  assunto            String?               @db.VarChar(200)
  corpo              String                @db.Text
  /// Degrau do escalonamento que gerou esta notificacao.
  nivelEscalonamento Int                   @default(0)
  status             StatusNotificacao     @default(SIMULADA)
  prioridade         PrioridadeNotificacao @default(MEDIA)
  /// `true` quando o disparo saiu como resumo agrupado, nao individual.
  agrupada           Boolean               @default(false)
  /// Canal de fallback declarado pela matriz (VOZ ou EMAIL_REFORCO).
  canalFallback      String?               @db.VarChar(20)
  erro               String?               @db.VarChar(300)

  criadoEm DateTime @default(now())

  @@index([clienteId, criadoEm])
  @@index([planoAcaoId])
  @@map("notificacao")
}

/// Usuario da plataforma — Etapa 8.
///
/// A senha e guardada como hash scrypt com sal por usuario; o texto puro nunca
/// e persistido nem registrado em log ou auditoria.
model Usuario {
  id    String @id @default(uuid())
  nome  String @db.VarChar(120)
  email String @unique @db.VarChar(150)

  /// Formato: scrypt$<sal-hex>$<hash-hex>.
  senhaHash String @db.VarChar(300)

  perfil   Perfil
  cargo    String? @db.VarChar(80)
  telefone String? @db.VarChar(11)

  /// Restringe o acesso a um unico cliente (perfil CLIENTE).
  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  ativo        Boolean   @default(true)
  ultimoAcesso DateTime?
  /// Valor da hora do consultor — base do cartao de ponto por cliente.
  valorHora    Decimal?  @db.Decimal(10, 2)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  registrosPonto RegistroPonto[]

  @@index([perfil, ativo])
  @@map("usuario")
}

/// Trilha de auditoria — obrigatoria em sistemas de SSMA para provar
/// quem alterou o que e quando.
model RegistroAuditoria {
  id         String        @id @default(uuid())
  entidade   String        @db.VarChar(60)
  entidadeId String        @db.VarChar(60)
  acao       AcaoAuditoria
  /// Diferenca aplicada: { campo: { de, para } }.
  alteracoes Json?
  autor      String?       @db.VarChar(150)
  ip         String?       @db.VarChar(60)
  criadoEm   DateTime      @default(now())

  @@index([entidade, entidadeId, criadoEm])
  @@map("registro_auditoria")
}

/**
 * ==========================================================================
 * Etapa 9 — Saude ocupacional e documentacao legal
 * ==========================================================================
 */

enum VinculoColaborador {
  /// Empregado proprio do cliente.
  CLIENTE
  /// Empregado de uma empresa contratada.
  TERCEIRO
  /// Equipe da propria consultoria.
  CONSULTORIA
}

enum SituacaoColaborador {
  ATIVO
  AFASTADO
  DESLIGADO
}

/// Grau de risco da funcao (NR-4) — define a periodicidade do exame periodico.
enum GrauRiscoFuncao {
  BAIXO
  MEDIO
  ALTO
}

/// Tipos de exame previstos na NR-7.
enum TipoAso {
  ADMISSIONAL
  PERIODICO
  RETORNO_AO_TRABALHO
  MUDANCA_DE_RISCO
  DEMISSIONAL
}

enum ResultadoAso {
  APTO
  APTO_COM_RESTRICAO
  INAPTO
}

enum TipoDocumento {
  PGR
  PCMSO
  LTCAT
  PPP
  PCA
  PPR
  LAUDO_INSALUBRIDADE
  LAUDO_PERICULOSIDADE
  LAUDO_ERGONOMICO
  AVCB
  LICENCA_AMBIENTAL
  ART_RT
  CERTIFICADO_TREINAMENTO
  PROCEDIMENTO
  APR_AST
  PERMISSAO_TRABALHO
  FISPQ
  PAE
  PCMAT
  /// Documentos legais do colaborador (pasta do trabalhador).
  FICHA_REGISTRO
  CONTRATO_TRABALHO
  ACORDO_COMPENSACAO_HORAS
  ORDEM_SERVICO
  FICHA_EPI
  /// Documentos ambientais.
  PGRSS
  PGRS
  CTR_MANIFESTO
  INVENTARIO_RESIDUOS
  OUTRO
}

/// A que o documento se aplica.
enum AbrangenciaDocumento {
  CLIENTE
  AREA
  TERCEIRO
  COLABORADOR
  OCORRENCIA
}

enum SituacaoDocumento {
  ATIVO
  SUBSTITUIDO
  CANCELADO
}

/// Pessoa que trabalha na operacao — sujeito do ASO e do PPP.
///
/// O CPF e unico por cliente, e nao global: a mesma pessoa pode prestar
/// servico em contratos diferentes, com funcao e grau de risco proprios.
model Colaborador {
  id        String  @id @default(uuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  vinculo    VinculoColaborador
  /// Obrigatorio quando o vinculo e TERCEIRO — e quem responde pelo ASO.
  terceiroId String?
  terceiro   Terceiro?          @relation(fields: [terceiroId], references: [id], onDelete: SetNull)
  /// Area de lotacao, quando aplicavel.
  areaId     String?
  area       Area?              @relation(fields: [areaId], references: [id], onDelete: SetNull)

  // --- Identificacao --------------------------------------------------------
  nome           String    @db.VarChar(120)
  cpf            String    @db.VarChar(11)
  matricula      String?   @db.VarChar(30)
  dataNascimento DateTime? @db.Date

  // --- Trabalho -------------------------------------------------------------
  funcao             String          @db.VarChar(80)
  setor              String?         @db.VarChar(80)
  grauRisco          GrauRiscoFuncao @default(MEDIO)
  /// Riscos ocupacionais da funcao, separados por ponto e virgula.
  riscosOcupacionais String?         @db.VarChar(300)
  dataAdmissao       DateTime?       @db.Date
  dataDesligamento   DateTime?       @db.Date

  // --- Contato --------------------------------------------------------------
  email    String? @db.VarChar(150)
  telefone String? @db.VarChar(11)

  /// Lideranca direta (supervisor/encarregado) — usada em afastamentos e consequencias.
  liderNome String? @db.VarChar(120)
  /// Foto 3x4 para carteirinha e fichas.
  fotoUrl   String? @db.VarChar(300)

  // --- Liberacao para o trabalho --------------------------------------------
  /// Bloqueio manual (documentacao pendente, medida disciplinar...): impede o acesso ao trabalho.
  bloqueado      Boolean   @default(false)
  motivoBloqueio String?   @db.VarChar(300)
  bloqueadoEm    DateTime?

  /// Token do QR Code da carteirinha — pagina publica de verificacao.
  tokenCarteirinha String? @unique @db.VarChar(64)

  situacao    SituacaoColaborador @default(ATIVO)
  observacoes String?             @db.VarChar(1000)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  brigadista    Brigadista[]
  asos          Aso[]
  documentos    DocumentoSsma[]
  treinamentos  TreinamentoRealizado[]
  entregasEpi   EntregaEpi[]
  consequencias Consequencia[]
  acidentes     Acidente[]
  afastamentos  Afastamento[]
  ordensServico OrdemServico[]
  checklists    ExecucaoChecklist[]

  @@unique([clienteId, cpf])
  @@index([clienteId, situacao])
  @@index([terceiroId])
  @@map("colaborador")
}

/// Atestado de Saude Ocupacional (NR-7).
///
/// O historico e preservado: um novo periodico nao apaga o anterior, porque a
/// fiscalizacao pede a sequencia completa de exames.
model Aso {
  id            String      @id @default(uuid())
  colaboradorId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  tipo      TipoAso
  dataExame DateTime  @db.Date
  /// Nulo no demissional, que nao gera proximo periodico.
  validade  DateTime? @db.Date

  resultado  ResultadoAso
  /// Obrigatoria quando ha restricao ou inaptidao.
  restricoes String?      @db.VarChar(500)

  // --- Medico examinador ----------------------------------------------------
  medicoNome        String  @db.VarChar(120)
  medicoCrm         String  @db.VarChar(20)
  /// Coordenador do PCMSO, quando diferente do examinador.
  medicoCoordenador String? @db.VarChar(120)

  // --- Conteudo -------------------------------------------------------------
  riscosAvaliados      String? @db.VarChar(300)
  examesComplementares String? @db.VarChar(500)
  observacoes          String? @db.VarChar(1000)
  /// Digitalizacao do atestado.
  arquivoUrl           String? @db.VarChar(300)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([colaboradorId, dataExame])
  @@index([validade])
  @@map("aso")
}

/// Documento legal SSMA: programas, laudos, licencas e certificados.
model DocumentoSsma {
  id        String  @id @default(uuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  abrangencia   AbrangenciaDocumento
  areaId        String?
  area          Area?                @relation(fields: [areaId], references: [id], onDelete: SetNull)
  terceiroId    String?
  terceiro      Terceiro?            @relation(fields: [terceiroId], references: [id], onDelete: SetNull)
  colaboradorId String?
  colaborador   Colaborador?         @relation(fields: [colaboradorId], references: [id], onDelete: SetNull)
  observacaoId  String?
  observacaoRef Observacao?          @relation(fields: [observacaoId], references: [id], onDelete: SetNull)

  // --- Identificacao --------------------------------------------------------
  tipo      TipoDocumento
  titulo    String        @db.VarChar(150)
  numero    String?       @db.VarChar(50)
  revisao   String?       @db.VarChar(20)
  descricao String?       @db.VarChar(1000)

  // --- Vigencia -------------------------------------------------------------
  dataEmissao DateTime  @db.Date
  /// Nulo em documentos sem prazo (PPP, procedimento).
  validade    DateTime? @db.Date

  // --- Responsavel tecnico --------------------------------------------------
  responsavelNome     String? @db.VarChar(120)
  /// Registro profissional: CREA, CRM, CRT...
  responsavelRegistro String? @db.VarChar(40)
  numeroArt           String? @db.VarChar(40)

  situacao    SituacaoDocumento @default(ATIVO)
  observacoes String?           @db.VarChar(1000)
  arquivoUrl  String?           @db.VarChar(300)

  // --- Controle de versao ---------------------------------------------------
  /// Uma nova versao e um registro NOVO que aponta para o anterior. O antigo
  /// permanece intacto (situacao SUBSTITUIDO, vigente=false): a evidencia
  /// continua exibida exatamente como foi emitida, e o historico e navegavel.
  versao           Int            @default(1)
  vigente          Boolean        @default(true)
  versaoAnteriorId String?        @unique
  versaoAnterior   DocumentoSsma? @relation("VersoesDocumento", fields: [versaoAnteriorId], references: [id], onDelete: SetNull)
  versaoSeguinte   DocumentoSsma? @relation("VersoesDocumento")

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([clienteId, situacao])
  @@index([clienteId, tipo])
  @@index([clienteId, vigente])
  @@index([validade])
  @@map("documento_ssma")
}

/**
 * ==========================================================================
 * Etapa 11 — Treinamentos e Matriz de Capacitacao
 * ==========================================================================
 */

/// Catalogo de treinamentos: a NR, a carga e o prazo de reciclagem.
model Treinamento {
  id String @id @default(uuid())

  nome              String  @db.VarChar(120)
  /// Norma ou origem da exigencia (NR-10, LOTO, Integracao...).
  norma             String? @db.VarChar(40)
  descricao         String? @db.VarChar(500)
  cargaHorariaHoras Decimal @db.Decimal(6, 1)
  /// Reciclagem em meses. Nulo = sem reciclagem obrigatoria.
  validadeMeses     Int?
  ativo             Boolean @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  requisitos  RequisitoCapacitacao[]
  realizacoes TreinamentoRealizado[]

  @@unique([nome])
  @@map("treinamento")
}

/// Matriz de capacitacao: a FUNCAO exige o treinamento.
///
/// Global da consultoria — um eletricista precisa de NR-10 em qualquer
/// contrato. A funcao e o mesmo texto do cadastro do colaborador.
model RequisitoCapacitacao {
  id String @id @default(uuid())

  funcao        String      @db.VarChar(80)
  treinamentoId String
  treinamento   Treinamento @relation(fields: [treinamentoId], references: [id], onDelete: Cascade)

  criadoEm DateTime @default(now())

  @@unique([funcao, treinamentoId])
  @@index([funcao])
  @@map("requisito_capacitacao")
}

/// Quem fez o que, quando, e ate quando vale.
///
/// O historico e preservado: a reciclagem nao apaga o registro anterior —
/// auditoria pede a sequencia completa, como no ASO.
model TreinamentoRealizado {
  id String @id @default(uuid())

  colaboradorId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  treinamentoId String
  treinamento   Treinamento @relation(fields: [treinamentoId], references: [id], onDelete: Cascade)

  dataRealizacao    DateTime  @db.Date
  /// Nulo = sem reciclagem obrigatoria (vale para sempre).
  validade          DateTime? @db.Date
  instrutor         String?   @db.VarChar(120)
  cargaHorariaHoras Decimal?  @db.Decimal(6, 1)
  observacoes       String?   @db.VarChar(500)
  /// Digitalizacao do certificado.
  certificadoUrl    String?   @db.VarChar(300)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([colaboradorId, treinamentoId, dataRealizacao])
  @@index([validade])
  @@map("treinamento_realizado")
}

/**
 * ==========================================================================
 * Etapa 12 — Auditorias
 * ==========================================================================
 */

enum TipoAuditoria {
  ISO_45001
  ISO_14001
  ISO_50001
  INTERNA
  CLIENTE
  LEGAL
}

enum SituacaoAuditoria {
  PLANEJADA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

/// Auditoria realizada num cliente/contrato. O score e derivado na leitura
/// (atendidos / avaliados) — nao ha nota digitada a mao.
model Auditoria {
  id        String  @id @default(uuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  tipo           TipoAuditoria
  titulo         String            @db.VarChar(150)
  dataRealizacao DateTime          @db.Date
  auditor        String?           @db.VarChar(120)
  /// Orgao, certificadora ou norma especifica (para LEGAL).
  referencia     String?           @db.VarChar(120)
  situacao       SituacaoAuditoria @default(PLANEJADA)

  // --- Resultado ------------------------------------------------------------
  requisitosAvaliados   Int?
  requisitosAtendidos   Int?
  ncMaiores             Int     @default(0)
  ncMenores             Int     @default(0)
  oportunidadesMelhoria Int     @default(0)
  observacoes           String? @db.VarChar(1000)
  relatorioUrl          String? @db.VarChar(300)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([clienteId, dataRealizacao])
  @@index([tipo, situacao])
  @@map("auditoria")
}

/**
 * ==========================================================================
 * Etapa 13 — DDS Digital
 * ==========================================================================
 */

/// Banco de temas de DDS — semeado do acervo da consultoria.
model TemaDds {
  id        String  @id @default(uuid())
  numero    Int     @unique
  titulo    String  @db.VarChar(150)
  categoria String? @db.VarChar(80)
  ativo     Boolean @default(true)

  registros RegistroDds[]

  @@map("tema_dds")
}

/// Realizacao de um DDS: quem conduziu, onde, quantos participaram.
model RegistroDds {
  id        String  @id @default(uuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  areaId    String?
  area      Area?   @relation(fields: [areaId], references: [id], onDelete: SetNull)

  temaId    String?
  tema      TemaDds? @relation(fields: [temaId], references: [id], onDelete: SetNull)
  /// Assunto do dia quando nao esta no banco de temas.
  temaLivre String?  @db.VarChar(150)

  data             DateTime @db.Date
  lider            String   @db.VarChar(120)
  participantes    Int
  duracaoMinutos   Int?
  observacoes      String?  @db.VarChar(1000)
  /// Lista de presenca digitalizada.
  listaPresencaUrl String?  @db.VarChar(300)
  /// Roteiro do DDS (texto apresentado) — digitado ou gerado pela assistente.
  conteudo         String?  @db.Text
  geradoPorIa      Boolean  @default(false)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([clienteId, data])
  @@map("registro_dds")
}

/**
 * ==========================================================================
 * Etapa 14 — Gestao de EPI e Estoque
 * ==========================================================================
 */

enum MotivoEntregaEpi {
  PRIMEIRA_ENTREGA
  SUBSTITUICAO
  PERDA
  DANIFICADO
}

/// Catalogo de EPI com CA (NR-06), estoque e ponto de reposicao.
model Epi {
  id String @id @default(uuid())

  nome          String    @db.VarChar(120)
  /// Certificado de Aprovacao.
  ca            String    @db.VarChar(20)
  validadeCa    DateTime? @db.Date
  fornecedor    String?   @db.VarChar(120)
  custoUnitario Decimal?  @db.Decimal(10, 2)
  /// Troca periodica em meses. Nulo = troca por desgaste.
  vidaUtilMeses Int?
  estoqueAtual  Int       @default(0)
  estoqueMinimo Int       @default(0)
  /// Estoque "cheio" (lote de compra). Sem minimo informado, o ponto de
  /// reposicao e 10% deste valor.
  estoqueReferencia Int?
  categoria     String?   @db.VarChar(60)
  ativo         Boolean   @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  entregas EntregaEpi[]
  anexos   AnexoEpi[]
  entradas EntradaEpi[]

  @@unique([nome, ca])
  @@index([validadeCa])
  @@map("epi")
}

/// Ficha de entrega NR-06: quem recebeu o que, quando e por que.
model EntregaEpi {
  id            String      @id @default(uuid())
  epiId         String
  epi           Epi         @relation(fields: [epiId], references: [id], onDelete: Cascade)
  colaboradorId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  data        DateTime         @db.Date
  quantidade  Int              @default(1)
  motivo      MotivoEntregaEpi @default(PRIMEIRA_ENTREGA)
  observacoes String?          @db.VarChar(500)
  /// Proxima troca prevista (data + vida util do EPI). Nulo = troca por desgaste.
  validadeTroca DateTime? @db.Date

  // --- Assinatura do recebimento (carimbada) ---------------------------------
  assinaturaUrl  String?   @db.VarChar(300)
  assinaturaHash String?   @db.VarChar(64)
  assinaturaEm   DateTime?

  criadoEm DateTime @default(now())

  @@index([colaboradorId, data])
  @@index([epiId, data])
  @@map("entrega_epi")
}

/**
 * ==========================================================================
 * Etapa 15 — Gestao de Consequencias
 * ==========================================================================
 */

enum MedidaDisciplinar {
  ORIENTACAO_VERBAL
  ADVERTENCIA_ESCRITA
  SUSPENSAO
  DESLIGAMENTO
  RECICLAGEM_TREINAMENTO
}

enum MotivacaoConsequencia {
  CLIENTE
  INTERNA
  AUDITORIA
  REINCIDENCIA
}

/// Registro de gestao de consequencia — formato da planilha real da operacao.
model Consequencia {
  id            String      @id @default(uuid())
  colaboradorId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  observacaoId String?
  observacao   Observacao? @relation(fields: [observacaoId], references: [id], onDelete: SetNull)

  liderNome      String                @db.VarChar(120)
  data           DateTime              @db.Date
  comportamento  String                @db.VarChar(200)
  detalhamento   String                @db.VarChar(2000)
  medida         MedidaDisciplinar
  motivacao      MotivacaoConsequencia @default(INTERNA)
  responsavelSst String?               @db.VarChar(120)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([colaboradorId, data])
  @@map("consequencia")
}

/**
 * ==========================================================================
 * Etapa 16 — Meio Ambiente e ESG
 * ==========================================================================
 */

enum TipoOcorrenciaAmbiental {
  DERRAMAMENTO
  VAZAMENTO
  EMISSAO_NAO_CONTROLADA
  DESCARTE_IRREGULAR
  PRODUTO_QUIMICO
  OUTRO
}

/// Ocorrencia ambiental — a meta do plano diretor e ZERO.
/// Grau I dispara a matriz de comunicacao (Meio Ambiente 0h → Diretoria +4h).
model OcorrenciaAmbiental {
  id        String  @id @default(uuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  areaId    String?
  area      Area?   @relation(fields: [areaId], references: [id], onDelete: SetNull)

  tipo           TipoOcorrenciaAmbiental
  data           DateTime                @db.Date
  descricao      String                  @db.VarChar(2000)
  /// I, II ou III — mesmo vocabulario do restante da plataforma.
  grauRisco      String                  @db.VarChar(3)
  volumeEstimado String?                 @db.VarChar(40)
  contida        Boolean                 @default(false)
  acaoImediata   String?                 @db.VarChar(1000)
  responsavel    String                  @db.VarChar(120)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([clienteId, data])
  @@map("ocorrencia_ambiental")
}

/// Leitura mensal dos indicadores ESG por cliente.
model IndicadorAmbiental {
  id        String  @id @default(uuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  /// Sempre o dia 1 do mes.
  competencia          DateTime @db.Date
  aguaM3               Decimal? @db.Decimal(14, 2)
  energiaKwh           Decimal? @db.Decimal(14, 2)
  residuosKg           Decimal? @db.Decimal(14, 2)
  residuosRecicladosKg Decimal? @db.Decimal(14, 2)
  emissoesTco2         Decimal? @db.Decimal(14, 3)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([clienteId, competencia])
  @@map("indicador_ambiental")
}

/**
 * ==========================================================================
 * Etapa 18 — Acidentes, CAT e Investigacao
 * ==========================================================================
 */

enum TipoAcidente {
  TIPICO
  TRAJETO
  DOENCA_OCUPACIONAL
}

enum SituacaoInvestigacao {
  ABERTA
  EM_INVESTIGACAO
  CONCLUIDA
}

/// Acidente formal: CAT (S-2210) e investigacao com causa raiz.
model Acidente {
  id            String       @id @default(uuid())
  clienteId     String
  cliente       Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  areaId        String?
  area          Area?        @relation(fields: [areaId], references: [id], onDelete: SetNull)
  colaboradorId String?
  colaborador   Colaborador? @relation(fields: [colaboradorId], references: [id], onDelete: SetNull)
  observacaoId  String?
  observacao    Observacao?  @relation(fields: [observacaoId], references: [id], onDelete: SetNull)
  planoAcaoId   String?
  planoAcao     PlanoAcao?   @relation(fields: [planoAcaoId], references: [id], onDelete: SetNull)

  data               DateTime     @db.Date
  tipo               TipoAcidente
  descricao          String       @db.VarChar(2000)
  parteCorpoAtingida String?      @db.VarChar(300)
  comAfastamento     Boolean      @default(false)
  diasAfastamento    Int          @default(0)
  /// Lesao permanente (NBR 14280): define os dias debitados.
  lesaoPermanente    String?      @db.VarChar(40)
  /// Dias debitados pela tabela NBR 14280 (morte 6000, perda de membro 3000, visao de um olho 1800).
  diasDebitados      Int          @default(0)

  catNumero    String?   @db.VarChar(40)
  catEmitidaEm DateTime? @db.Date

  situacaoInvestigacao    SituacaoInvestigacao @default(ABERTA)
  investigador            String?              @db.VarChar(120)
  causaRaiz               String?              @db.VarChar(1000)
  fatoresContribuintes    String?              @db.VarChar(1000)
  investigacaoConcluidaEm DateTime?            @db.Date

  // --- Investigacao estruturada --------------------------------------------
  /// Diagrama de Ishikawa (6M): { metodo, maquina, material, maoDeObra,
  /// medida, meioAmbiente }, cada um uma lista de causas. Validado no schema
  /// compartilhado; guardado como JSON porque a forma e fixa e nao e consultada
  /// por coluna.
  ishikawa     Json?
  /// Os 5 Porques: lista ordenada de "por que?" ate a causa raiz.
  cincoPorques Json?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  afastamentos Afastamento[]

  @@index([clienteId, data])
  @@map("acidente")
}

/**
 * ==========================================================================
 * Etapa 19 — Inventario de Riscos (GRO / PGR)
 * ==========================================================================
 */

enum TipoRisco {
  FISICO
  QUIMICO
  BIOLOGICO
  ERGONOMICO
  ACIDENTE
}

/// Hierarquia de controles da NR-1: EPI e o ultimo recurso, nao o primeiro.
enum NivelControle {
  ELIMINACAO
  SUBSTITUICAO
  ENGENHARIA
  ADMINISTRATIVO
  EPI
}

enum SituacaoRisco {
  IDENTIFICADO
  EM_TRATAMENTO
  CONTROLADO
  MONITORADO
}

/// Linha do inventario de riscos que sustenta o PGR (NR-1).
///
/// O IIR e persistido junto dos fatores: o valor precisa ficar estavel no
/// documento assinado, mesmo que a regua do motor mude depois.
model InventarioRisco {
  id        String  @id @default(uuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  areaId    String?
  area      Area?   @relation(fields: [areaId], references: [id], onDelete: SetNull)
  /// Contexto alternativo a area: o perigo da funcao.
  funcao    String? @db.VarChar(80)

  tipo           TipoRisco
  perigo         String    @db.VarChar(150)
  fonteGeradora  String?   @db.VarChar(200)
  atividade      String?   @db.VarChar(200)
  danosPossiveis String    @db.VarChar(500)

  severidade    Int
  probabilidade Int
  exposicao     Int
  frequencia    Int
  /// S x P x E x F — mesma regua do IIR das observacoes de campo.
  iir           Int
  /// I, II ou III, derivado do IIR.
  grauRisco     String @db.VarChar(3)

  controlesExistentes String?        @db.VarChar(1000)
  nivelControleAtual  NivelControle?
  medidasPropostas    String?        @db.VarChar(1000)
  planoAcaoId         String?
  planoAcao           PlanoAcao?     @relation(fields: [planoAcaoId], references: [id], onDelete: SetNull)

  situacao    SituacaoRisco @default(IDENTIFICADO)
  responsavel String?       @db.VarChar(120)
  /// Proxima reavaliacao — o PGR e documento vivo.
  reavaliarEm DateTime?     @db.Date

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([clienteId, situacao])
  @@index([clienteId, iir])
  @@map("inventario_risco")
}

/**
 * ==========================================================================
 * Etapa 21 — Absenteismo
 * ==========================================================================
 */

enum TipoAfastamento {
  DOENCA_COMUM
  DOENCA_OCUPACIONAL
  ACIDENTE_TRABALHO
  ACIDENTE_TRAJETO
  MATERNIDADE
  PATERNIDADE
  LICENCA_TRATAMENTO
  OUTRO
}

/// Parametros de custo configuráveis por cliente para o cálculo de
/// indicadores financeiros (custo evitado, ROI).
///
/// Se clienteId for nulo, é o padrão global da consultoria.
/// Cada cliente pode ter seu próprio conjunto de parâmetros.
model ParametrosFinanceiros {
  id        String  @id @default(uuid())
  clienteId String? @unique
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  /// Custo médio por acidente COM afastamento (CAT, indenização, hora parada).
  custoAcidenteComAfastamento Float @default(50000)
  /// Custo médio por acidente SEM afastamento (médico, primeiros socorros, hora parada).
  custoAcidenteSemAfastamento Float @default(5000)
  /// Custo médio por dia de afastamento (benefícios INSS, produtividade perdida).
  custoDiaAfastamento         Float @default(300)
  /// Custo por hora de parada de produção (equipamento + mão de obra parada).
  custoHoraParadaProducao     Float @default(2000)
  /// Valor médio de multa NR (base: NR-28 tabela de infrações).
  custoMultaNrMedia           Float @default(20000)
  /// Fator de redução de acidentes atribuído ao programa BBS (0.0–1.0).
  /// Padrão 0,3 = 30% de prevenção com BBS ativo.
  fatorPreventivoBbs          Float @default(0.3)
  /// Valor mensal do contrato da consultoria, para calcular ROI (opcional).
  valorContratoMensal         Float?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("parametros_financeiros")
}

/// Periodo de afastamento de um colaborador.
///
/// A taxa de absenteismo (TA) e calculada sobre estes registros:
/// TA = (total_dias_afastados / (n_colaboradores x dias_uteis_periodo)) x 100
///
/// O vinculo com Acidente e opcional: afastamentos por doenca comum nao
/// precisam de CAT.
model Afastamento {
  id        String  @id @default(uuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  colaboradorId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  /// Acidente registrado que originou o afastamento, quando aplicavel.
  acidenteId String?
  acidente   Acidente? @relation(fields: [acidenteId], references: [id], onDelete: SetNull)

  tipo            TipoAfastamento
  dataInicio      DateTime        @db.Date
  /// Nulo enquanto o retorno ainda nao foi registrado.
  dataFim         DateTime?       @db.Date
  /// Dias de afastamento. Calculado em diasFimInicio, mas persistido para
  /// consultas rapidas e para nao mudar quando a data de fim e editada.
  diasAfastamento Int             @default(0)

  /// CID-10 quando disponivel (doenca e doenca ocupacional).
  cid       String? @db.VarChar(10)
  descricao String? @db.VarChar(500)

  /// Funcao, setor e lideranca no momento do afastamento (fotografia).
  funcao    String? @db.VarChar(80)
  setor     String? @db.VarChar(80)
  liderNome String? @db.VarChar(120)
  /// Providencias no retorno: REABILITACAO, TREINAMENTO, MUDANCA_FUNCAO, ATIVIDADE_COMPATIVEL.
  providencias Json?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([clienteId, dataInicio])
  @@index([colaboradorId, dataInicio])
  @@map("afastamento")
}

/**
 * ==========================================================================
 * Etapa 23 — Documentacao Tecnica: OS, APR e checklists de pre-uso
 * ==========================================================================
 */

enum SituacaoOs {
  EMITIDA
  ASSINADA
  SUBSTITUIDA
}

/// Ordem de Servico por funcao (NR-1, item 1.4.4): informa ao trabalhador os
/// riscos da funcao e as medidas de prevencao.
///
/// E GERADA, nao digitada: o servidor consolida os riscos do inventario
/// (por funcao e por area de lotacao), os EPIs entregues e os treinamentos
/// exigidos para a funcao, e grava um SNAPSHOT. O snapshot importa porque a OS
/// e prova do que o trabalhador foi informado NAQUELE momento — se o inventario
/// mudar depois, a OS assinada nao muda junto; gera-se uma nova versao.
model OrdemServico {
  id            String      @id @default(uuid())
  clienteId     String
  cliente       Cliente     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  colaboradorId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  /// Identificador legivel (OS-0001).
  codigo String @unique @db.VarChar(20)
  versao Int    @default(1)

  /// Copiados do colaborador no momento da geracao.
  funcao    String          @db.VarChar(80)
  setor     String?         @db.VarChar(80)
  grauRisco GrauRiscoFuncao

  /// Snapshot: [{ tipo, perigo, danosPossiveis, grauRisco, iir, controles, medidasPropostas }]
  riscos              Json
  /// Snapshot: [{ nome, ca, dataEntrega }]
  episObrigatorios    Json
  /// Snapshot: [{ nome, norma, situacao }] — exigidos pela matriz de capacitacao.
  treinamentosExigidos Json
  /// Texto livre complementar (procedimentos, restricoes).
  medidasPreventivas  String? @db.VarChar(2000)

  situacao SituacaoOs @default(EMITIDA)
  geradaEm DateTime   @default(now())
  geradaPor String    @db.VarChar(120)

  // --- Ciencia do trabalhador (assinatura carimbada) ------------------------
  cienciaEm            DateTime?
  cienciaAssinaturaUrl String?   @db.VarChar(300)
  cienciaHash          String?   @db.VarChar(64)
  /// Copia assinada em papel, digitalizada (PDF ou imagem).
  arquivoAssinadoUrl   String?   @db.VarChar(300)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([clienteId, situacao])
  @@index([colaboradorId, versao])
  @@map("ordem_servico")
}

enum SituacaoApr {
  RASCUNHO
  APROVADA
  ENCERRADA
}

/// Analise Preliminar de Risco: a atividade decomposta em etapas, cada uma com
/// perigos, riscos e medidas de controle.
model Apr {
  id         String    @id @default(uuid())
  clienteId  String
  cliente    Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  areaId     String?
  area       Area?     @relation(fields: [areaId], references: [id], onDelete: SetNull)
  terceiroId String?
  terceiro   Terceiro? @relation(fields: [terceiroId], references: [id], onDelete: SetNull)

  /// Identificador legivel (APR-0001). Todas as versoes da mesma APR
  /// compartilham o codigo; o que as distingue e a versao.
  codigo String @db.VarChar(20)
  versao Int    @default(1)

  /// APR (padrao) ou AST — Analise de Seguranca da Tarefa (modelo COMAU).
  modelo      String    @default("APR") @db.VarChar(10)
  atividade   String    @db.VarChar(200)
  local       String?   @db.VarChar(200)
  dataInicio  DateTime  @db.Date
  dataFim     DateTime? @db.Date
  responsavel String    @db.VarChar(120)
  /// Tipos de servico especiais: ESPACO_CONFINADO, TRABALHO_A_QUENTE, TRABALHO_EM_ALTURA,
  /// ICAMENTO_DE_CARGA, ESCAVACAO, REQUER_BLOQUEIO.
  tiposServico Json?

  /// [{ etapa, perigos, riscos, medidasControle, epis }]
  etapas Json

  situacao    SituacaoApr @default(RASCUNHO)
  aprovadaPor String?     @db.VarChar(120)
  aprovadaEm  DateTime?
  /// Carimbo da aprovacao: hash do conteudo das etapas + aprovador + momento.
  aprovacaoHash String?   @db.VarChar(64)

  /// Digitalizacao da APR assinada em campo, quando houver.
  arquivoUrl String? @db.VarChar(300)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([codigo, versao])
  @@index([clienteId, situacao])
  @@index([areaId, dataInicio])
  @@map("apr")
}

enum ResultadoChecklist {
  APTO
  NAO_APTO
}

/// Modelo de checklist de pre-uso: a lista de itens a verificar em um tipo de
/// equipamento antes de opera-lo.
model ModeloChecklist {
  id        String  @id @default(uuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  nome            String  @db.VarChar(120)
  tipoEquipamento String  @db.VarChar(80)
  /// [{ descricao, impeditivo }] — impeditivo=true: nao conforme reprova o equipamento.
  itens           Json
  ativo           Boolean @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  execucoes ExecucaoChecklist[]

  @@index([clienteId, ativo])
  @@map("modelo_checklist")
}

/// Execucao de um checklist antes do uso: quem verificou o que, com foto.
model ExecucaoChecklist {
  id            String          @id @default(uuid())
  clienteId     String
  cliente       Cliente         @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  modeloId      String
  modelo        ModeloChecklist @relation(fields: [modeloId], references: [id], onDelete: Restrict)
  areaId        String?
  area          Area?           @relation(fields: [areaId], references: [id], onDelete: SetNull)
  colaboradorId String?
  colaborador   Colaborador?    @relation(fields: [colaboradorId], references: [id], onDelete: SetNull)

  equipamentoIdentificacao String   @db.VarChar(120)
  dataHora                 DateTime @default(now())
  executadoPor             String   @db.VarChar(120)

  /// [{ descricao, impeditivo, conforme, observacao }] — copia dos itens do
  /// modelo com a resposta, para que a execucao sobreviva a edicao do modelo.
  respostas Json
  /// Derivado das respostas: qualquer impeditivo nao conforme reprova.
  resultado ResultadoChecklist
  fotoUrl   String?            @db.VarChar(300)
  /// Carimbo: hash das respostas + executor + momento.
  hash      String?            @db.VarChar(64)

  criadoEm DateTime @default(now())

  @@index([clienteId, dataHora])
  @@index([modeloId, dataHora])
  @@map("execucao_checklist")
}

/**
 * ==========================================================================
 * Etapa 24 — Melhorias da plataforma (levantamento da operacao)
 * ==========================================================================
 */

/// Contatos hierarquicos do cliente: quem e o supervisor, o coordenador, o
/// gerente... E o que transforma os papeis da matriz de comunicacao em pessoas
/// reais com e-mail — a cobranca da chefia e o escalonamento chegam a eles.
model ContatoCliente {
  id        String  @id @default(uuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  nome     String  @db.VarChar(120)
  cargo    String? @db.VarChar(80)
  /// Nivel da hierarquia (SUPERVISOR, COORDENADOR, GERENTE, DIRETORIA, SSMA, RH...).
  nivel    String  @db.VarChar(30)
  email    String  @db.VarChar(150)
  telefone String? @db.VarChar(11)
  whatsapp String? @db.VarChar(11)
  /// Recebe os alertas e cobrancas do seu nivel.
  recebeAlertas Boolean @default(true)
  observacoes   String? @db.VarChar(300)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([clienteId, nivel])
  @@map("contato_cliente")
}

/// Anexos do EPI: laudo, CA, ficha tecnica, nota fiscal.
model AnexoEpi {
  id    String @id @default(uuid())
  epiId String
  epi   Epi    @relation(fields: [epiId], references: [id], onDelete: Cascade)

  titulo String @db.VarChar(120)
  /// LAUDO, CA, FICHA_TECNICA, NOTA_FISCAL, OUTRO
  tipo   String @db.VarChar(20)
  url    String @db.VarChar(300)

  criadoEm DateTime @default(now())

  @@index([epiId])
  @@map("anexo_epi")
}

/// Entrada de estoque (compra): quantidade, custo e nota fiscal.
model EntradaEpi {
  id    String @id @default(uuid())
  epiId String
  epi   Epi    @relation(fields: [epiId], references: [id], onDelete: Cascade)

  data          DateTime @db.Date
  quantidade    Int
  custoUnitario Decimal? @db.Decimal(10, 2)
  notaFiscal    String?  @db.VarChar(40)
  fornecedor    String?  @db.VarChar(120)
  observacoes   String?  @db.VarChar(300)

  criadoEm DateTime @default(now())

  @@index([epiId, data])
  @@map("entrada_epi")
}

/// Fornecedores da consultoria (EPI, laboratorios, treinamentos...).
model Fornecedor {
  id String @id @default(uuid())

  nome        String  @db.VarChar(150)
  cnpj        String? @db.VarChar(14)
  categoria   String? @db.VarChar(80)
  contatoNome String? @db.VarChar(120)
  telefone    String? @db.VarChar(11)
  whatsapp    String? @db.VarChar(11)
  email       String? @db.VarChar(150)
  site        String? @db.VarChar(150)
  observacoes String? @db.VarChar(500)
  ativo       Boolean @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  lancamentos LancamentoFinanceiro[]

  @@index([nome])
  @@map("fornecedor")
}

enum TipoLancamento {
  RECEITA
  DESPESA
}

enum SituacaoLancamento {
  PENDENTE
  PAGO
  CANCELADO
}

/// Planilha financeira da consultoria: receitas por cliente e despesas.
model LancamentoFinanceiro {
  id        String   @id @default(uuid())
  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  fornecedorId String?
  fornecedor   Fornecedor? @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)

  tipo       TipoLancamento
  categoria  String             @db.VarChar(80)
  descricao  String             @db.VarChar(200)
  valor      Decimal            @db.Decimal(12, 2)
  data       DateTime           @db.Date
  vencimento DateTime?          @db.Date
  situacao   SituacaoLancamento @default(PENDENTE)
  notaFiscal String?            @db.VarChar(40)
  observacoes String?           @db.VarChar(500)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([data, tipo])
  @@index([clienteId, data])
  @@map("lancamento_financeiro")
}

/// Cartao de ponto do consultor: horas trabalhadas por cliente, valoradas pela hora.
model RegistroPonto {
  id        String   @id @default(uuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  data              DateTime  @db.Date
  entrada           DateTime
  saida             DateTime?
  intervaloMinutos  Int       @default(0)
  atividade         String?   @db.VarChar(300)
  /// Horas liquidas (saida - entrada - intervalo), persistidas ao fechar o registro.
  horasTrabalhadas  Decimal?  @db.Decimal(6, 2)
  /// Valor da hora no momento do registro (fotografia do cadastro do usuario).
  valorHora         Decimal?  @db.Decimal(10, 2)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([usuarioId, data])
  @@index([clienteId, data])
  @@map("registro_ponto")
}

enum SituacaoCipa {
  PLANEJAMENTO
  PROCESSO_ELEITORAL
  EM_MANDATO
  ENCERRADA
}

/// Gestao da CIPA (NR-5): mandato, processo eleitoral, membros e documentos.
model Cipa {
  id        String  @id @default(uuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  /// Ex.: "2026/2027".
  gestao            String       @db.VarChar(20)
  dataInicioMandato DateTime     @db.Date
  dataFimMandato    DateTime     @db.Date
  situacao          SituacaoCipa @default(PLANEJAMENTO)

  /// Cronograma do processo eleitoral: [{ etapa, data, concluida }].
  cronograma Json?
  /// Membros: [{ nome, funcao, setor, representacao: EMPREGADOR|EMPREGADOS, tipo: TITULAR|SUPLENTE, cargo?: PRESIDENTE|VICE|SECRETARIO, votos? }].
  membros    Json?
  observacoes String? @db.Text

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  documentos CipaDocumento[]

  @@index([clienteId, situacao])
  @@map("cipa")
}

/// Documento da CIPA: edital, ficha de inscricao, lista de presenca, cedula, ata, certificado.
model CipaDocumento {
  id     String @id @default(uuid())
  cipaId String
  cipa   Cipa   @relation(fields: [cipaId], references: [id], onDelete: Cascade)

  /// EDITAL, FICHA_INSCRICAO, LISTA_PRESENCA_VOTACAO, CEDULA_VOTACAO, ATA_ELEICAO, ATA_POSSE, ATA_REUNIAO, CERTIFICADO_TREINAMENTO, CALENDARIO, OUTRO
  tipo        String    @db.VarChar(30)
  titulo      String    @db.VarChar(150)
  url         String    @db.VarChar(300)
  data        DateTime? @db.Date
  observacoes String?   @db.VarChar(300)

  criadoEm DateTime @default(now())

  @@index([cipaId])
  @@map("cipa_documento")
}

/// Avaliacao ergonomica (NR-17): checklist pontuado por area ou funcao.
model AvaliacaoErgonomica {
  id        String  @id @default(uuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  areaId    String?
  area      Area?   @relation(fields: [areaId], references: [id], onDelete: SetNull)

  funcao    String?  @db.VarChar(80)
  data      DateTime @db.Date
  avaliador String   @db.VarChar(120)
  /// CHECKLIST (preliminar), AEP (avaliacao ergonomica preliminar) ou AET (analise ergonomica do trabalho).
  tipo      String   @db.VarChar(12) @default("CHECKLIST")

  /// [{ categoria, item, conforme: boolean|null, observacao }]
  itens      Json
  /// % de itens conformes.
  pontuacao  Int?
  /// BAIXO, MEDIO, ALTO — derivado da pontuacao.
  nivelRisco String? @db.VarChar(10)

  conclusao     String? @db.Text
  recomendacoes String? @db.Text
  arquivoUrl    String? @db.VarChar(300)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([clienteId, data])
  @@map("avaliacao_ergonomica")
}

/// Inventario de produtos quimicos com classificacao GHS e FDS.
model ProdutoQuimico {
  id        String  @id @default(uuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  areaId    String?
  area      Area?   @relation(fields: [areaId], references: [id], onDelete: SetNull)

  nome       String  @db.VarChar(150)
  fabricante String? @db.VarChar(120)
  numeroCas  String? @db.VarChar(20)
  /// Estado fisico: SOLIDO, LIQUIDO, GAS, AEROSSOL.
  estadoFisico String? @db.VarChar(12)

  /// Pictogramas GHS: ["GHS02", "GHS07", ...]
  pictogramas       Json?
  /// PERIGO ou ATENCAO.
  palavraAdvertencia String? @db.VarChar(10)
  frasesPerigo       String? @db.VarChar(500)
  /// Classe de perigo resumida (inflamavel, corrosivo, toxico...).
  classificacao      String? @db.VarChar(200)

  localArmazenamento String?  @db.VarChar(150)
  quantidadeEstoque  Decimal? @db.Decimal(12, 2)
  unidade            String?  @db.VarChar(10)
  episNecessarios    String?  @db.VarChar(300)
  medidasControle    String?  @db.VarChar(500)

  /// FDS (ficha com dados de seguranca) anexada e sua validade.
  fdsUrl      String?   @db.VarChar(300)
  fdsValidade DateTime? @db.Date

  observacoes String? @db.VarChar(500)
  ativo       Boolean @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([clienteId, nome])
  @@map("produto_quimico")
}

enum FuncaoBrigada {
  COORDENADOR
  CHEFE
  LIDER
  BRIGADISTA
}

/// Brigada de incendio: membros, funcao na brigada, treinamento e reciclagem.
model Brigadista {
  id            String      @id @default(uuid())
  clienteId     String
  cliente       Cliente     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  colaboradorId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  areaId        String?
  area          Area?       @relation(fields: [areaId], references: [id], onDelete: SetNull)

  funcaoBrigada       FuncaoBrigada @default(BRIGADISTA)
  turno               String?       @db.VarChar(40)
  dataTreinamento     DateTime?     @db.Date
  validadeTreinamento DateTime?     @db.Date
  certificadoUrl      String?       @db.VarChar(300)
  fotoUrl             String?       @db.VarChar(300)
  ativo               Boolean       @default(true)
  observacoes         String?       @db.VarChar(300)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([clienteId, colaboradorId])
  @@index([clienteId, ativo])
  @@map("brigadista")
}

enum TipoExtintor {
  AGUA
  PO_ABC
  PO_BC
  CO2
  ESPUMA
  CLASSE_K
  OUTRO
}

enum SituacaoExtintor {
  OK
  VENCIDO
  EM_MANUTENCAO
  OBSTRUIDO
}

/// Controle de extintores: localizacao, validades e inspecao.
model Extintor {
  id        String  @id @default(uuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  areaId    String?
  area      Area?   @relation(fields: [areaId], references: [id], onDelete: SetNull)

  numero      String       @db.VarChar(30)
  tipo        TipoExtintor
  capacidade  String?      @db.VarChar(20)
  localizacao String       @db.VarChar(150)

  validadeCarga             DateTime? @db.Date
  validadeTesteHidrostatico DateTime? @db.Date
  ultimaInspecao            DateTime? @db.Date
  situacao                  SituacaoExtintor @default(OK)
  observacoes               String?   @db.VarChar(300)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([clienteId, numero])
  @@index([clienteId, situacao])
  @@map("extintor")
}

/// Levantamento de aspectos e impactos ambientais (ISO 14001).
model AspectoAmbiental {
  id        String  @id @default(uuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  areaId    String?
  area      Area?   @relation(fields: [areaId], references: [id], onDelete: SetNull)

  atividade String @db.VarChar(150)
  aspecto   String @db.VarChar(150)
  impacto   String @db.VarChar(200)
  /// NORMAL, ANORMAL ou EMERGENCIA.
  condicao  String @db.VarChar(12) @default("NORMAL")

  severidade    Int
  probabilidade Int
  /// Severidade x probabilidade.
  significancia Int
  significativo Boolean @default(false)

  controles      String? @db.VarChar(500)
  requisitoLegal String? @db.VarChar(200)
  responsavel    String? @db.VarChar(120)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([clienteId, significativo])
  @@map("aspecto_ambiental")
}

/// Modelos de relatorio da consultoria (texto com marcadores), geraveis com assistente.
model ModeloRelatorio {
  id String @id @default(uuid())

  titulo    String  @db.VarChar(150)
  categoria String? @db.VarChar(60)
  descricao String? @db.VarChar(300)
  /// Texto do modelo em Markdown, com marcadores como {{cliente}}, {{periodo}}.
  conteudo  String  @db.Text
  ativo     Boolean @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("modelo_relatorio")
}
