# ---------------------------------------------------------------------------
# SafetyGuard EHS 360 — variaveis de ambiente
# Copie para .env  ->  cp .env.example .env
#
# Este arquivo cobre o desenvolvimento local, onde um unico .env na raiz serve
# a API e ao front. Em producao sao DOIS projetos na Vercel, cada um com o seu
# proprio conjunto: veja docs/deploy-vercel.md.
# ---------------------------------------------------------------------------

# Banco de dados
# Local (docker compose expoe o Postgres na porta 5434 do host):
DATABASE_URL="postgresql://safetyguard:safetyguard@localhost:5434/safetyguard?schema=public"
# Supabase (producao) — Settings > Database > Connection string > URI:
# DATABASE_URL="postgresql://postgres:<senha>@db.<ref>.supabase.co:5432/postgres?schema=public"

# API
API_PORT=3333
API_HOST=0.0.0.0
NODE_ENV=development

# Origens liberadas no CORS (lista separada por virgula).
# Cada entrada aceita `*` dentro de um segmento, o que cobre os dominios de
# preview da Vercel, que mudam a cada push.
CORS_ORIGIN="http://localhost:5173"
# Producao: "https://seu-front.vercel.app,https://*.vercel.app"

# Diretorio de uploads (usado so quando o Supabase Storage nao esta configurado)
UPLOAD_DIR="./uploads"
UPLOAD_MAX_MB=5

# URL publica da API, usada para montar links de arquivos
PUBLIC_API_URL="http://localhost:3333"

# Base do link gravado no QR Code das areas — precisa apontar para o FRONT
PUBLIC_APP_URL="http://localhost:5173"

# Autenticacao — TROQUE JWT_SECRET em producao
JWT_SECRET="desenvolvimento-safetyguard-trocar"
JWT_EXPIRA_EM="12h"

# Usuario administrador criado pelo seed
ADMIN_EMAIL="admin@safetyguard.com.br"
ADMIN_SENHA="SafetyGuard2026"

# ---------------------------------------------------------------------------
# Front-end (Vite) — apenas variaveis VITE_* chegam ao navegador
# ---------------------------------------------------------------------------

# Em desenvolvimento aponta para a API local. Em producao, para o dominio do
# projeto da API. Uma URL de localhost e ignorada quando a pagina nao esta em
# localhost, entao copiar este valor para a Vercel por engano nao quebra o site.
VITE_API_URL="http://localhost:3333"

# ---------------------------------------------------------------------------
# Supabase
# Chaves em: https://supabase.com/dashboard/project/<ref>/settings/api
# ---------------------------------------------------------------------------

# Servidor — a service_role ignora RLS e NUNCA pode ir para o front
# SUPABASE_URL="https://<ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="<service_role_jwt>"

# Navegador — a anon key e publica por design
# VITE_SUPABASE_URL="https://<ref>.supabase.co"
# VITE_SUPABASE_ANON_KEY="<anon_jwt>"

# ---------------------------------------------------------------------------
# E-mail SMTP (opcional — sem isto os alertas caem no modo de teste Ethereal)
# ---------------------------------------------------------------------------
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORT=587
# SMTP_USER="<usuario>"
# SMTP_PASS="<chave>"
# SMTP_FROM="SafetyGuard Alertas <alertas@suaconsultoria.com.br>"
# ALERTA_EMAIL_COPIA="gestor@suaconsultoria.com.br"
