# ---------------------------------------------------------------------------
# SafetyGuard EHS 360 — variaveis de ambiente
# Copie para .env  ->  cp .env.example .env
# ---------------------------------------------------------------------------

# Banco de dados (docker compose expoe o Postgres na porta 5434 do host)
DATABASE_URL="postgresql://safetyguard:safetyguard@localhost:5434/safetyguard?schema=public"

# API
API_PORT=3333
API_HOST=0.0.0.0
NODE_ENV=development

# Origens liberadas no CORS (separadas por virgula)
CORS_ORIGIN="http://localhost:5173"

# Diretorio de uploads (logo da empresa, evidencias)
UPLOAD_DIR="./uploads"
UPLOAD_MAX_MB=5

# URL publica da API, usada pelo front e para montar links de arquivos
PUBLIC_API_URL="http://localhost:3333"

# Base do link gravado no QR Code das areas
PUBLIC_APP_URL="http://localhost:5173"

# Autenticacao — TROQUE JWT_SECRET em producao
JWT_SECRET="desenvolvimento-safetyguard-trocar"
JWT_EXPIRA_EM="12h"

# Usuario administrador criado pelo seed
ADMIN_EMAIL="admin@safetyguard.com.br"
ADMIN_SENHA="SafetyGuard2026"

# Front-end (Vite)
VITE_API_URL="http://localhost:3333"
