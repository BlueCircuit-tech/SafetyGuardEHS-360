{
  "name": "safetyguard-ehs-360",
  "version": "0.1.0",
  "private": true,
  "description": "SafetyGuard EHS 360 — plataforma de gestao de Seguranca, Saude e Meio Ambiente",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm run dev --workspace @safetyguard/api",
    "dev:web": "npm run dev --workspace @safetyguard/web",
    "build": "npm run build --workspace @safetyguard/shared && npm run build --workspace @safetyguard/api && npm run build --workspace @safetyguard/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate --workspace @safetyguard/api",
    "db:seed": "npm run db:seed --workspace @safetyguard/api",
    "db:studio": "npm run db:studio --workspace @safetyguard/api",
    "setup": "npm install && npm run build --workspace @safetyguard/shared && npm run db:up && npm run db:migrate && npm run db:seed"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
